# SWDA Prime RLM endpoint configuration.
# Copy to .env and fill in. .env is git-ignored; repo-root .env loads first, then cwd .env.
# Precedence: constructor args / --model flag > process env > .env > built-in defaults.

# OpenAI-compatible gateway base URL (no trailing /chat/completions).
OPENAI_BASE_URL=http://100.77.223.42:8415/v1

# Gateway API key. NEVER commit a real key; keep it in .env only.
OPENAI_API_KEY=sb-REPLACE-ME

# Primary model id. Use `swda models` to list live ids from the gateway.
# Default when unset: auto-free.
SWDA_MODEL=auto-free

# Comma-separated fallback chain tried in order on model_not_allowed.
# auto-free is always appended if missing.
SWDA_FALLBACK_MODELS=openrouter/free,auto-free
